# ─────────────────────────────────────────────────────────────
# Kurukshetra Kart — Environment Configuration
# Copy this file to .env and fill in production values
# ─────────────────────────────────────────────────────────────

# Application
PROJECT_NAME="Kurukshetra Kart Telemetry & Digital Twin Platform"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security — CHANGE THIS IN PRODUCTION
SECRET_KEY="kurukshetra-kart-insecure-development-secret-key-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# SQLite for development / trackside edge deployment:
DATABASE_URL="sqlite:///./kurukshetra_kart.db"
# PostgreSQL for production:
# DATABASE_URL="postgresql://kart_user:kart_pass@localhost:5432/kurukshetra_kart"

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Telemetry Ingestion
UDP_HOST="0.0.0.0"
UDP_PORT=8888
SERIAL_PORT="COM3"
SERIAL_BAUDRATE=115200

# File Storage Paths
RAW_STORAGE_DIR="./data/raw"
REPORTS_STORAGE_DIR="./reports"
ML_MODELS_DIR="./machine-learning/registry"

